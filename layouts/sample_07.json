  "text_replacement": {
    "rules": [
      {
        "find": "RE:",
        "replace": "reply to"
      },
      {
        "find": "FWD:",
        "replace": "forwarded"
      },
      {
        "find": "Inbox (",
        "replace": "Inbox, "
      }
    ],
    "enabled": true
  },
  "text_filters": {
    "char_normalization": true,
    "ignored_words": "Unsubscribe, View in browser"
  },
  "automations": {
    "area_combos": [
      {
        "name": "Read the Mail",
        "hotkey": "f4",
        "enabled": true,
        "repeat_seconds": 0,
        "capture_first": false,
        "steps": [
