  "text_replacement": {
    "rules": [
      {
        "find": "san",
        "replace": "Mr or Ms"
      },
      {
        "find": "sama",
        "replace": "sir or madam"
      }
    ],
    "enabled": true
  },
  "text_filters": {
    "char_normalization": true,
    "ignore_already_read": true,
    "ignored_words": "Auto, Skip"
